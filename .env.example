# Clerk (from Vercel integration or Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redirect URLs (required for custom /login and /signup pages)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/cases
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/cases

# Local dev: if Google/OAuth sign-in returns HTTP 431, restart `pnpm dev` after pulling
# (package.json raises Node's max-http-header-size). Also clear localhost cookies if it persists.

# Clerk Billing plan keys (Configure → Billing → Subscription plans)
# free_user — default free tier (3 investigations)
# premium — $9.99/mo or $69/yr

# Clerk auth (Dashboard → User & authentication)
# Password min length: User & authentication → Password → Minimum password length (8 recommended)
# Google OAuth: Configure → SSO connections → Add connection → Google
#   For production, add OAuth client in Google Cloud Console with redirect URI from Clerk.
#   Dev mode uses Clerk's shared credentials automatically.

# Neon (from Vercel integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public site URL (canonical, Open Graph, sitemap)
NEXT_PUBLIC_APP_URL=https://casenull.com

# Set to true / 1 / yes to redirect the whole site to /maintenance
# SITE_MAINTENANCE=false

# Preview gate — block public access until launch; testers enter COMING_SOON_PASSWORD
# COMING_SOON=false
# COMING_SOON_PASSWORD=

# Floating dev tools panel (local dev is always on; set this for preview/staging only)
# NEXT_PUBLIC_DEV_TOOLS=false

# PostHog — analytics (cookie consent) and error monitoring (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side capture (same project API key; keep out of NEXT_PUBLIC_)
POSTHOG_API_KEY=

# Resend — transactional email (https://resend.com)
# Domain mail.casenull.com must be verified in Resend.
RESEND_API_KEY=

# Resend marketing — segment for product updates / newsletters (Dashboard → Segments)
# Your "General" segment ID from Resend.
RESEND_MARKETING_SEGMENT_ID=

# Clerk webhooks — signing secret from Dashboard → Webhooks → your endpoint
# Subscribe to: user.created, user.updated, user.deleted, subscriptionItem.active, subscriptionItem.canceled,
# subscriptionItem.pastDue, subscriptionItem.ended, subscriptionItem.freeTrialEnding
CLERK_WEBHOOK_SIGNING_SECRET=
